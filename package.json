{
  "name": "bomuc-website",
  "private": true,
  "description": "Development and CI tooling for the boMUC static site. Not deployed.",
  "scripts": {
    "build": "bash tools/build.sh",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "html-validate index.html impressum.html 404.html",
    "lint:css": "stylelint \"css/**/*.css\"",
    "lint:js": "eslint js/main.js tests/*.spec.js eslint.config.mjs",
    "test": "npm run test:a11y && npm run test:e2e && npm run test:links",
    "test:a11y": "start-server-and-test serve http://127.0.0.1:4173 test:a11y:run",
    "test:a11y:run": "pa11y-ci --config pa11yci.json",
    "test:e2e": "playwright test",
    "test:links": "node tests/check-links.mjs",
    "lighthouse": "start-server-and-test serve http://127.0.0.1:4173 lighthouse:run",
    "lighthouse:run": "lhci autorun",
    "serve": "python3 -m http.server 4173 --directory _site",
    "check": "npm run lint && npm run build && npm run test && npm run lighthouse"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.9.1",
    "html-validate": "^11.10.0",
    "pa11y-ci": "^4.1.1",
    "start-server-and-test": "^3.0.12",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0"
  }
}
